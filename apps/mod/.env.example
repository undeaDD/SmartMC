# Copy to .env (gitignored) and fill in with your own paths.

# Local test server's mods folder, used by `bun run build:test` (see
# scripts/deploy-test-jar.ts) to copy a freshly-built jar there directly.
# Example (PrismLauncher on Windows):
# SMARTMC_TEST_MODS_DIR=C:\Users\you\AppData\Roaming\PrismLauncher\instances\Your Instance\minecraft\mods
SMARTMC_TEST_MODS_DIR=
