---
import Layout from '../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

const milestones = (await getCollection('roadmap')).sort((a, b) => a.data.order - b.data.order);

const statusLabel: Record<string, string> = {
  done: 'Done',
  'in-progress': 'In progress',
  planned: 'Planned',
};
---

<Layout title="Roadmap">
  <section class="relative overflow-hidden">
    <div class="bg-grid absolute inset-0"></div>
    <div class="relative mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 sm:py-24">
      <h1 class="text-glow text-4xl font-bold tracking-tight text-white sm:text-5xl">Roadmap</h1>
      <p class="mx-auto mt-4 max-w-xl text-brand-gray">
        Updated by hand as each milestone lands. Deliberately not wired to CI status.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 pb-24 sm:px-6">
    <ol class="divide-y divide-white/5">
      {milestones.map(async (milestone) => {
        const { Content } = await render(milestone);
        const active = milestone.data.status === 'in-progress';
        return (
          <li class="flex gap-6 py-10 sm:gap-10">
            <span
              class={`shrink-0 text-6xl font-bold leading-none sm:text-8xl ${active ? 'text-brand-green' : 'text-white'}`}
              style="mask-image: linear-gradient(to bottom, black 35%, transparent 95%); -webkit-mask-image: linear-gradient(to bottom, black 35%, transparent 95%); opacity: 0.9;"
            >
              {String(milestone.data.order).padStart(2, '0')}
            </span>
            <div class="min-w-0 pt-2">
              <div class="flex flex-wrap items-center gap-3">
                <h2 class="text-xl font-semibold text-white">{milestone.data.title}</h2>
                {milestone.data.status !== 'planned' && (
                  <span class={`rounded-full px-2.5 py-0.5 text-xs font-medium ${active ? 'bg-green-500/15 text-brand-green ring-1 ring-inset ring-green-500/30' : 'bg-white/5 text-brand-gray ring-1 ring-inset ring-white/10'}`}>
                    {statusLabel[milestone.data.status]}
                  </span>
                )}
                {milestone.data.date && (
                  <span class="text-xs text-brand-gray">{milestone.data.date}</span>
                )}
              </div>
              <div class="mt-2 max-w-none text-sm text-brand-gray">
                <Content />
              </div>
            </div>
          </li>
        );
      })}
    </ol>
  </section>
</Layout>
