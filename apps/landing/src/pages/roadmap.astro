---
import Layout from '../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

const milestones = (await getCollection('roadmap')).sort((a, b) => a.data.order - b.data.order);

const statusStyles: Record<string, string> = {
  done: 'bg-brand-500/15 text-brand-300 ring-1 ring-inset ring-brand-500/30',
  'in-progress': 'bg-amber-400/15 text-amber-300 ring-1 ring-inset ring-amber-400/30',
  planned: 'bg-white/5 text-neutral-400 ring-1 ring-inset ring-white/10',
};

const statusLabel: Record<string, string> = {
  done: 'Done',
  'in-progress': 'In progress',
  planned: 'Planned',
};

const dotStyles: Record<string, string> = {
  done: 'bg-brand-400',
  'in-progress': 'bg-amber-400',
  planned: 'bg-ink-600',
};
---

<Layout title="Roadmap">
  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-24">
    <h1 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">Roadmap</h1>
    <p class="mt-3 text-neutral-400">
      Updated by hand as each milestone lands — deliberately not wired to CI status.
    </p>

    <ol class="mt-12 space-y-10 border-l border-white/10 pl-8">
      {milestones.map(async (milestone) => {
        const { Content } = await render(milestone);
        return (
          <li class="relative">
            <span class={`absolute -left-[calc(2rem+5px)] top-1.5 h-2.5 w-2.5 rounded-full ${dotStyles[milestone.data.status]}`}></span>
            <div class="flex flex-wrap items-center gap-3">
              <h2 class="text-lg font-semibold text-white">{milestone.data.title}</h2>
              <span class={`rounded-full px-2.5 py-0.5 text-xs font-medium ${statusStyles[milestone.data.status]}`}>
                {statusLabel[milestone.data.status]}
              </span>
            </div>
            <div class="prose-none mt-2 max-w-none text-sm text-neutral-400">
              <Content />
            </div>
          </li>
        );
      })}
    </ol>
  </section>
</Layout>
