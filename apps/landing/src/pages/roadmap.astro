---
import Layout from '../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

const milestones = (await getCollection('roadmap')).sort((a, b) => a.data.order - b.data.order);

const statusStyles: Record<string, string> = {
  done: 'bg-green-500/15 text-green-300 ring-1 ring-inset ring-green-500/30',
  'in-progress': 'bg-teal-400/15 text-teal-300 ring-1 ring-inset ring-teal-400/30',
  planned: 'bg-white/5 text-brand-gray ring-1 ring-inset ring-white/10',
};

const statusLabel: Record<string, string> = {
  done: 'Done',
  'in-progress': 'In progress',
  planned: 'Planned',
};

const dotStyles: Record<string, string> = {
  done: 'bg-green-400 text-ink-950',
  'in-progress': 'bg-teal-400 text-ink-950',
  planned: 'bg-ink-600 text-white',
};
---

<Layout title="Roadmap">
  <section class="relative overflow-hidden">
    <div class="bg-grid absolute inset-0"></div>
    <div class="relative mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 sm:py-24">
      <h1 class="text-glow text-4xl font-bold tracking-tight text-white sm:text-5xl">Roadmap</h1>
      <p class="mx-auto mt-4 max-w-xl text-brand-gray">
        Updated by hand as each milestone lands. Deliberately not wired to CI status.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 pb-24 sm:px-6">
    <ol class="space-y-10 border-l border-white/10 pl-8">
      {milestones.map(async (milestone) => {
        const { Content } = await render(milestone);
        return (
          <li class="relative">
            <span class={`absolute -left-[calc(2rem+13px)] top-0 flex h-6 w-6 items-center justify-center rounded-full text-[11px] font-bold ${dotStyles[milestone.data.status]}`}>
              {milestone.data.order}
            </span>
            <div class="flex flex-wrap items-center gap-3">
              <h2 class="text-lg font-semibold text-white">{milestone.data.title}</h2>
              <span class={`rounded-full px-2.5 py-0.5 text-xs font-medium ${statusStyles[milestone.data.status]}`}>
                {statusLabel[milestone.data.status]}
              </span>
            </div>
            <div class="mt-2 max-w-none text-sm text-brand-gray">
              <Content />
            </div>
          </li>
        );
      })}
    </ol>
  </section>
</Layout>
