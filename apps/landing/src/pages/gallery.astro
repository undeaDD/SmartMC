---
import Layout from '../layouts/Layout.astro';
import Placeholder from '../components/Placeholder.astro';
import { withBase } from '../lib/paths';

const placeholders = [
  'App: device dashboard',
  'App: pairing flow',
  'In-game: alarm controller block',
  'App: group management',
  'In-game: pairing command',
  'App: notification',
];
---

<Layout title="Gallery">
  <section class="relative overflow-hidden">
    <div class="bg-grid absolute inset-0"></div>
    <div class="relative mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 sm:py-24">
      <h1 class="text-glow text-4xl font-bold tracking-tight text-white sm:text-5xl">Gallery</h1>
      <p class="mx-auto mt-4 max-w-xl text-brand-gray">
        Real screenshots and clips land here as features ship. See the <a class="text-brand-teal underline hover:text-teal-300" href={withBase('/roadmap')}>roadmap</a> for progress.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6">
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {placeholders.map((label) => (
        <Placeholder label={label} />
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 pb-24 sm:px-6">
    <div class="rounded-3xl border border-white/10 bg-ink-900/60 p-8 text-center sm:p-12">
      <h2 class="text-xl font-bold text-white sm:text-2xl">Got a screenshot worth sharing?</h2>
      <p class="mx-auto mt-3 max-w-md text-brand-gray">
        If you're running SmartMC and have something worth showing off, open an issue with your screenshot attached
        and it may end up here.
      </p>
      <a
        href="https://github.com/undeaDD/SmartMC/issues/new?title=Gallery%20submission&labels=gallery"
        class="mt-6 inline-flex items-center gap-2 rounded-lg bg-brand-green px-5 py-3 text-sm font-semibold text-ink-950 transition hover:bg-green-400"
      >
        Submit a screenshot
      </a>
    </div>
  </section>
</Layout>
