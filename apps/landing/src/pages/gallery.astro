---
import Layout from '../layouts/Layout.astro';
import Placeholder from '../components/Placeholder.astro';
import { withBase } from '../lib/paths';

const placeholders = [
  'App — device dashboard',
  'App — pairing flow',
  'In-game — alarm controller block',
  'App — group management',
  'In-game — pairing command',
  'App — notification',
];
---

<Layout title="Gallery">
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24">
    <h1 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">Gallery</h1>
    <p class="mt-3 max-w-2xl text-neutral-400">
      Real screenshots and clips land here as features ship — first candidate is the M5 alarm vertical slice. See the
      <a class="text-brand-400 underline hover:text-brand-300" href={withBase('/roadmap')}>roadmap</a> for progress.
    </p>
    <div class="mt-10 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {placeholders.map((label) => (
        <Placeholder label={label} />
      ))}
    </div>
  </section>
</Layout>
