---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL;
---

<Layout title="Gallery">
  <h1 class="text-3xl font-bold tracking-tight">Gallery</h1>
  <p class="mt-2 max-w-2xl text-neutral-600 dark:text-neutral-400">
    Screenshots and clips of the mod and app land here once there's something worth
    looking at — first candidate is the M5 alarm vertical slice.
  </p>
  <div class="mt-8 rounded-lg border border-dashed border-neutral-300 p-12 text-center text-sm text-neutral-500 dark:border-neutral-700 dark:text-neutral-400">
    Nothing to show yet — check the <a class="underline" href={`${base}roadmap`}>roadmap</a>.
  </div>
</Layout>
