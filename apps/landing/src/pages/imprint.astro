---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Imprint">
  <section class="relative overflow-hidden">
    <div class="bg-grid absolute inset-0"></div>
    <div class="relative mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 sm:py-24">
      <h1 class="text-glow text-4xl font-bold tracking-tight text-white sm:text-5xl">Imprint</h1>
    </div>
  </section>

  <section class="mx-auto max-w-2xl px-4 pb-24 sm:px-6">
    <div class="rounded-2xl border border-white/10 bg-ink-900/60 p-6 sm:p-10">
      <p class="font-semibold text-white">Devsforge</p>
      <p class="mt-1 text-sm text-brand-gray">
        <a class="text-brand-teal underline hover:text-teal-300" href="mailto:undeaD_D@live.de">undeaD_D@live.de</a>
      </p>
      <p class="mt-6 text-xs text-brand-gray/70">
        This imprint intentionally lists a contact email only, with no postal address. Some jurisdictions (Germany's
        Impressumspflicht, for example) require more than this for a fully compliant imprint. Worth revisiting if
        SmartMC ever operates in a context where that applies.
      </p>
    </div>
  </section>
</Layout>
