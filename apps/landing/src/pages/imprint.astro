---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Imprint">
  <section class="mx-auto max-w-2xl px-4 py-16 sm:px-6 sm:py-24">
    <h1 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">Imprint</h1>
    <div class="mt-8 space-y-4 text-sm text-brand-gray">
      <p class="rounded-xl border border-dashed border-ink-600 bg-ink-900/60 p-5 text-brand-gray">
        Placeholder. Replace with the legally required provider information for Devsforge (name, address, contact,
        and any registration details that apply to your jurisdiction) before this site is treated as production.
      </p>
      <div>
        <p class="font-semibold text-white">Devsforge</p>
        <p>Address line 1</p>
        <p>Address line 2</p>
        <p>Country</p>
      </div>
      <div>
        <p class="font-semibold text-white">Contact</p>
        <p>Email: contact@devsforge.example</p>
      </div>
    </div>
  </section>
</Layout>
