---
import Layout from '../layouts/Layout.astro';

type Contributor = {
  login: string;
  html_url: string;
  avatar_url: string;
  contributions: number;
};

let contributors: Contributor[] = [];
let fetchFailed = false;

try {
  const res = await fetch('https://api.github.com/repos/undeaDD/SmartMC/contributors');
  if (res.ok) {
    contributors = await res.json();
  } else {
    fetchFailed = true;
  }
} catch {
  fetchFailed = true;
}
---

<Layout title="Contributors">
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24">
    <h1 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">Contributors</h1>
    <p class="mt-3 max-w-2xl text-neutral-400">
      Pulled from GitHub at build time — no hand-maintained list to go stale.
    </p>

    {fetchFailed && (
      <p class="mt-10 text-sm text-neutral-500">
        Couldn't reach GitHub's API while building this page. See the
        <a class="text-brand-400 underline hover:text-brand-300" href="https://github.com/undeaDD/SmartMC/graphs/contributors"> contributors graph</a> directly.
      </p>
    )}

    {!fetchFailed && (
      <ul class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-5">
        {contributors.map((c) => (
          <li>
            <a href={c.html_url} class="flex flex-col items-center gap-2 rounded-xl border border-white/10 bg-ink-900/60 p-4 text-center transition hover:border-brand-500/30 hover:bg-ink-900">
              <img src={c.avatar_url} alt={c.login} width="64" height="64" class="rounded-full border border-white/10" />
              <span class="text-sm font-medium text-white">{c.login}</span>
              <span class="text-xs text-neutral-500">{c.contributions} commit{c.contributions === 1 ? '' : 's'}</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</Layout>
