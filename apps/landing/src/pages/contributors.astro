---
import Layout from '../layouts/Layout.astro';

type Contributor = {
  login: string;
  html_url: string;
  avatar_url: string;
  contributions: number;
};

let contributors: Contributor[] = [];
let fetchFailed = false;

try {
  const res = await fetch('https://api.github.com/repos/undeaDD/SmartMC/contributors');
  if (res.ok) {
    contributors = await res.json();
  } else {
    fetchFailed = true;
  }
} catch {
  fetchFailed = true;
}
---

<Layout title="Contributors">
  <section class="relative overflow-hidden">
    <div class="bg-grid absolute inset-0"></div>
    <div class="relative mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 sm:py-24">
      <h1 class="text-glow text-4xl font-bold tracking-tight text-white sm:text-5xl">Contributors</h1>
      <p class="mx-auto mt-4 max-w-xl text-brand-gray">
        Thank you to all the people who have contributed.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-24 sm:px-6">
    {fetchFailed && (
      <p class="mt-10 text-sm text-brand-gray">
        Couldn't reach GitHub's API while building this page. See the
        <a class="text-brand-teal underline hover:text-teal-300" href="https://github.com/undeaDD/SmartMC/graphs/contributors"> contributors graph</a> directly.
      </p>
    )}

    {!fetchFailed && (
      <ul class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-5">
        {contributors.map((c) => (
          <li>
            <a href={c.html_url} class="flex flex-col items-center gap-2 rounded-xl border border-white/10 bg-ink-900/60 p-4 text-center transition hover:border-green-500/30 hover:bg-ink-900">
              <img src={c.avatar_url} alt={c.login} width="64" height="64" class="rounded-full border border-white/10" />
              <span class="text-sm font-medium text-white">{c.login}</span>
              <span class="text-xs text-brand-gray">{c.contributions} commit{c.contributions === 1 ? '' : 's'}</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</Layout>
