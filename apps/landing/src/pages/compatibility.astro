---
import Icon from '../components/Icon.astro';
import Layout from '../layouts/Layout.astro';

type Status = 'compatible' | 'planned' | "won't add";

interface Entry {
  name: string;
  status: Status;
  link: string;
  note?: string;
  /** SmartMC version this integration is (or will be) available from. Left unset for entries SmartMC won't add. */
  since?: string;
}

// Third-party mods and services SmartMC could integrate with -- not to be
// confused with Minecraft loader/version support, which lives on the
// roadmap page instead.
const entries: Entry[] = [
  { name: 'Applied Energistics 2', status: 'planned', link: 'https://modrinth.com/mod/ae2', since: 'v1.0.0' },
  { name: 'Home Assistant', status: 'planned', link: 'https://www.home-assistant.io', note: 'Not a Minecraft mod, a smart home service', since: 'v1.0.0' },
  { name: 'Refined Storage', status: 'planned', link: 'https://modrinth.com/mod/refined-storage', since: 'v1.0.0' },
  { name: 'FTB Teams', status: 'planned', link: 'https://www.curseforge.com/minecraft/mc-mods/ftb-teams-forge', note: 'Optional group backend. SmartMC has its own basic group system as a fallback.', since: 'v1.0.0' },
  { name: 'LuckPerms', status: 'planned', link: 'https://luckperms.net', note: 'Fine-grained permission nodes instead of vanilla op-levels', since: 'v1.0.0' },
  { name: 'BungeeCord', status: "won't add", link: 'https://github.com/SpigotMC/BungeeCord', note: 'Proxy networks split state across multiple servers' },
  { name: 'Velocity', status: "won't add", link: 'https://velocitypowered.com', note: 'Proxy networks split state across multiple servers' },
];

const statusOrder: Record<Status, number> = { compatible: 0, planned: 1, "won't add": 2 };
const sorted = [...entries].sort((a, b) => {
  const byStatus = statusOrder[a.status] - statusOrder[b.status];
  return byStatus !== 0 ? byStatus : a.name.localeCompare(b.name);
});

const statusStyle: Record<Status, string> = {
  compatible: 'text-brand-green bg-green-500/10 ring-green-500/30',
  planned: 'text-amber-400 bg-amber-400/10 ring-amber-400/30',
  "won't add": 'text-brand-gray bg-white/5 ring-white/10',
};

const statusIcon: Record<Status, 'check-circle' | 'clock' | 'xmark-circle'> = {
  compatible: 'check-circle',
  planned: 'clock',
  "won't add": 'xmark-circle',
};

const statusLabel: Record<Status, string> = {
  compatible: 'Compatible',
  planned: 'Planned',
  "won't add": "Won't add",
};
---

<Layout title="Compatibility">
  <section class="relative overflow-hidden">
    <div class="bg-grid absolute inset-0"></div>
    <div class="relative mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 sm:py-24">
      <h1 class="text-glow text-4xl font-bold tracking-tight text-white sm:text-5xl">Compatibility</h1>
      <p class="mx-auto mt-4 max-w-xl text-brand-gray">
        Third-party mods and services SmartMC integrates or could integrate with. For Minecraft loader and version
        support, see the roadmap instead.
      </p>
      <a
        href="https://github.com/undeaDD/SmartMC/issues/new?title=Compatibility%20request&labels=compatibility"
        class="mt-6 inline-flex items-center gap-2 rounded-lg bg-brand-green px-5 py-3 text-sm font-semibold text-ink-950 transition hover:bg-green-400"
      >
        Request mod compatibility
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 pb-24 sm:px-6">
    <div class="overflow-hidden rounded-2xl border border-white/10">
      <table class="w-full text-left text-sm">
        <thead class="bg-white/5 text-xs uppercase tracking-wider text-brand-gray">
          <tr>
            <th class="px-5 py-3 font-semibold">Mod</th>
            <th class="px-5 py-3 font-semibold">Status</th>
            <th class="px-5 py-3 font-semibold">Version</th>
            <th class="px-5 py-3 font-semibold">Link</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-white/5">
          {sorted.map((entry) => (
            <tr class="bg-ink-900/60">
              <td class="px-5 py-4">
                <p class="font-medium text-white">{entry.name}</p>
                {entry.note && <p class="mt-0.5 text-xs text-brand-gray">{entry.note}</p>}
              </td>
              <td class="px-5 py-4">
                <span class={`inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-xs font-medium ring-1 ring-inset ${statusStyle[entry.status]}`}>
                  <Icon name={statusIcon[entry.status]} class="h-3.5 w-3.5" />
                  {statusLabel[entry.status]}
                </span>
              </td>
              <td class="px-5 py-4 text-brand-gray">{entry.since ?? '—'}</td>
              <td class="px-5 py-4">
                <a href={entry.link} class="inline-flex items-center gap-1 font-medium text-brand-teal hover:text-teal-300">
                  Visit <Icon name="arrow-right" class="h-3.5 w-3.5" />
                </a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</Layout>
