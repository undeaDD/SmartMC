---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'SmartMC',
  description = 'A Minecraft-native smart home & alarm platform. No central server to host.',
} = Astro.props;

// import.meta.env.BASE_URL already ends with a trailing slash (e.g. "/SmartMC/"),
// so paths below are appended without a leading slash of their own.
const base = import.meta.env.BASE_URL;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title} · SmartMC</title>
  </head>
  <body class="min-h-screen bg-white text-neutral-900 dark:bg-neutral-950 dark:text-neutral-100">
    <header class="border-b border-neutral-200 dark:border-neutral-800">
      <nav class="mx-auto flex max-w-4xl items-center justify-between px-4 py-4">
        <a href={base} class="text-lg font-semibold tracking-tight">SmartMC</a>
        <div class="flex gap-5 text-sm">
          <a href={`${base}roadmap`} class="hover:underline">Roadmap</a>
          <a href={`${base}faq`} class="hover:underline">FAQ</a>
          <a href={`${base}gallery`} class="hover:underline">Gallery</a>
          <a href={`${base}contributors`} class="hover:underline">Contributors</a>
          <a href={`${base}wiki/players`} class="hover:underline">Wiki</a>
          <a href="https://github.com/undeaDD/SmartMC" class="hover:underline">GitHub</a>
        </div>
      </nav>
    </header>
    <main class="mx-auto max-w-4xl px-4 py-10">
      <slot />
    </main>
    <footer class="mx-auto max-w-4xl border-t border-neutral-200 px-4 py-6 text-sm text-neutral-500 dark:border-neutral-800 dark:text-neutral-400">
      <p>SmartMC is source-available under the <a class="underline" href="https://github.com/undeaDD/SmartMC/blob/main/LICENSE">PolyForm Noncommercial License 1.0.0</a>.</p>
    </footer>
  </body>
</html>
