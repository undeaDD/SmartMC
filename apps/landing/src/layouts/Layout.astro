---
import '../styles/global.css';
import ObfuscatedEmail from '../components/ObfuscatedEmail.astro';
import SmartMcLogo from '../components/SmartMcLogo.astro';
import { withBase } from '../lib/paths';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'SmartMC',
  description = 'A Minecraft-native smart home & alarm platform. No central server to host.',
} = Astro.props;

const nav = [
  { label: 'Home', href: withBase('/') },
  { label: 'Compatibility', href: withBase('/compatibility') },
  { label: 'Roadmap', href: withBase('/roadmap') },
  { label: 'FAQ', href: withBase('/faq') },
  { label: 'Gallery', href: withBase('/gallery') },
  { label: 'Contributors', href: withBase('/contributors') },
  { label: 'Docs', href: withBase('/wiki/players') },
];

const year = new Date().getFullYear();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="alternate icon" href={withBase('/favicon.ico')} />
    <title>{title} · SmartMC</title>
  </head>
  <body class="min-h-screen text-white/90 antialiased">
    <header class="sticky top-0 z-50 border-b border-white/5 bg-ink-950/80 backdrop-blur">
      <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4 sm:px-6">
        <a href={withBase('/')} class="flex items-center gap-2 text-lg font-bold tracking-tight text-white">
          <span class="flex h-7 w-7 items-center justify-center">
            <SmartMcLogo class="h-7 w-7 text-brand-green" />
          </span>
          SmartMC
        </a>
        <div class="hidden items-center gap-7 text-sm font-medium text-brand-gray md:flex">
          {nav.map((item) => (
            <a href={item.href} class="transition hover:text-white">{item.label}</a>
          ))}
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="border-t border-white/5">
      <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
        <div class="grid grid-cols-2 gap-10 sm:grid-cols-5">
          <div class="col-span-2 sm:col-span-1">
            <a href={withBase('/')} class="flex items-center gap-2 text-base font-bold text-white">
              <span class="flex h-7 w-7 items-center justify-center">
                <SmartMcLogo class="h-7 w-7 text-brand-green" />
              </span>
              SmartMC
            </a>
            <p class="mt-3 max-w-xs text-sm text-brand-gray">
              A Minecraft-native smart home & alarm platform.
            </p>
          </div>
          <div>
            <p class="text-sm font-semibold text-white">Product</p>
            <ul class="mt-3 space-y-2 text-sm text-brand-gray">
              <li><a class="transition hover:text-brand-green" href={withBase('/#features')}>Features</a></li>
              <li><a class="transition hover:text-brand-green" href={withBase('/compatibility')}>Compatibility</a></li>
              <li><a class="transition hover:text-brand-green" href={withBase('/gallery')}>Gallery</a></li>
            </ul>
          </div>
          <div>
            <p class="text-sm font-semibold text-white">Docs</p>
            <ul class="mt-3 space-y-2 text-sm text-brand-gray">
              <li><a class="transition hover:text-brand-green" href={withBase('/wiki/players')}>For players</a></li>
              <li><a class="transition hover:text-brand-green" href={withBase('/wiki/server-owners')}>For server owners</a></li>
              <li><a class="transition hover:text-brand-green" href={withBase('/wiki/developers')}>For developers</a></li>
            </ul>
          </div>
          <div>
            <p class="text-sm font-semibold text-white">Community</p>
            <ul class="mt-3 space-y-2 text-sm text-brand-gray">
              <li><a class="transition hover:text-brand-green" href="https://github.com/undeaDD/SmartMC">GitHub</a></li>
              <li><a class="transition hover:text-brand-green" href="https://github.com/undeaDD/SmartMC/issues">Report an issue</a></li>
              <li><a class="transition hover:text-brand-green" href={withBase('/contributors')}>Contributors</a></li>
            </ul>
          </div>
          <div>
            <p class="text-sm font-semibold text-white">Contact</p>
            <ul class="mt-3 space-y-2 text-sm text-brand-gray">
              <li><a class="transition hover:text-brand-green" href="https://discord.gg/ugef96S34">Discord</a></li>
              <li><a class="transition hover:text-brand-green" href="https://github.com/undeaDD/SmartMC">GitHub</a></li>
              <li><ObfuscatedEmail class="transition hover:text-brand-green" label="Email" /></li>
            </ul>
          </div>
        </div>
        <div class="mt-12 flex flex-col gap-3 border-t border-white/5 pt-6 text-xs text-brand-gray sm:flex-row sm:items-center sm:justify-between">
          <span>Copyright © {year} Devsforge</span>
          <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
            <a class="hover:text-white" href={withBase('/imprint')}>Imprint</a>
            <a class="hover:text-white" href={withBase('/privacy')}>Data privacy</a>
            <a class="hover:text-white" href={withBase('/license')}>License</a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
