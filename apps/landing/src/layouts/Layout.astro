---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { withBase } from '../lib/paths';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'SmartMC',
  description = 'A Minecraft-native smart home & alarm platform. No central server to host.',
} = Astro.props;

const nav = [
  { label: 'Features', href: withBase('/#features') },
  { label: 'Roadmap', href: withBase('/roadmap') },
  { label: 'FAQ', href: withBase('/faq') },
  { label: 'Gallery', href: withBase('/gallery') },
  { label: 'Docs', href: withBase('/wiki/players') },
];

const year = new Date().getFullYear();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title} · SmartMC</title>
  </head>
  <body class="min-h-screen text-neutral-200 antialiased">
    <header class="sticky top-0 z-50 border-b border-white/5 bg-ink-950/80 backdrop-blur">
      <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4 sm:px-6">
        <a href={withBase('/')} class="flex items-center gap-2 text-lg font-bold tracking-tight text-white">
          <span class="flex h-7 w-7 items-center justify-center rounded-md bg-brand-500 text-ink-950">
            <Icon name="shield" class="h-4 w-4" />
          </span>
          SmartMC
        </a>
        <div class="hidden items-center gap-7 text-sm font-medium text-neutral-400 md:flex">
          {nav.map((item) => (
            <a href={item.href} class="transition hover:text-white">{item.label}</a>
          ))}
        </div>
        <div class="flex items-center gap-3">
          <a
            href="https://github.com/undeaDD/SmartMC"
            class="hidden items-center gap-1.5 text-sm font-medium text-neutral-400 transition hover:text-white sm:flex"
          >
            <Icon name="github" class="h-4 w-4" />
            GitHub
          </a>
          <a
            href={withBase('/wiki/players')}
            class="rounded-lg bg-brand-500 px-3.5 py-2 text-sm font-semibold text-ink-950 shadow-[0_0_0_1px_rgba(0,0,0,0.05)] transition hover:bg-brand-400"
          >
            Get started
          </a>
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="border-t border-white/5">
      <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
        <div class="grid grid-cols-2 gap-10 sm:grid-cols-4">
          <div class="col-span-2 sm:col-span-1">
            <a href={withBase('/')} class="flex items-center gap-2 text-base font-bold text-white">
              <span class="flex h-6 w-6 items-center justify-center rounded-md bg-brand-500 text-ink-950">
                <Icon name="shield" class="h-3.5 w-3.5" />
              </span>
              SmartMC
            </a>
            <p class="mt-3 max-w-xs text-sm text-neutral-500">
              A Minecraft-native smart home &amp; alarm platform. No central server to host.
            </p>
          </div>
          <div>
            <p class="text-sm font-semibold text-white">Product</p>
            <ul class="mt-3 space-y-2 text-sm text-neutral-500">
              <li><a class="transition hover:text-brand-400" href={withBase('/#features')}>Features</a></li>
              <li><a class="transition hover:text-brand-400" href={withBase('/roadmap')}>Roadmap</a></li>
              <li><a class="transition hover:text-brand-400" href={withBase('/gallery')}>Gallery</a></li>
            </ul>
          </div>
          <div>
            <p class="text-sm font-semibold text-white">Docs</p>
            <ul class="mt-3 space-y-2 text-sm text-neutral-500">
              <li><a class="transition hover:text-brand-400" href={withBase('/wiki/players')}>For players</a></li>
              <li><a class="transition hover:text-brand-400" href={withBase('/wiki/server-owners')}>For server owners</a></li>
              <li><a class="transition hover:text-brand-400" href={withBase('/wiki/developers')}>For developers</a></li>
              <li><a class="transition hover:text-brand-400" href={withBase('/faq')}>FAQ</a></li>
            </ul>
          </div>
          <div>
            <p class="text-sm font-semibold text-white">Community</p>
            <ul class="mt-3 space-y-2 text-sm text-neutral-500">
              <li><a class="transition hover:text-brand-400" href="https://github.com/undeaDD/SmartMC">GitHub</a></li>
              <li><a class="transition hover:text-brand-400" href="https://github.com/undeaDD/SmartMC/issues">Report an issue</a></li>
              <li><a class="transition hover:text-brand-400" href={withBase('/contributors')}>Contributors</a></li>
            </ul>
          </div>
        </div>
        <div class="mt-12 flex flex-col gap-3 border-t border-white/5 pt-6 text-xs text-neutral-600 sm:flex-row sm:items-center sm:justify-between">
          <p>© {year} Devsforge. Source-available under the <a class="underline hover:text-brand-400" href="https://github.com/undeaDD/SmartMC/blob/main/LICENSE">PolyForm Noncommercial License 1.0.0</a>.</p>
          <p>Icons by <a class="underline hover:text-brand-400" href="https://iconoir.com">Iconoir</a>.</p>
        </div>
      </div>
    </footer>
  </body>
</html>
