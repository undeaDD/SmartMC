---
// Illustrations from Thiings (https://www.thiings.co), used under their free
// tier with attribution (see the footer). Self-hosted and run through
// Astro's image pipeline rather than hotlinked.
import { Image } from 'astro:assets';
import setupGear from '../assets/thiings/setup-gear.png';
import secureShield from '../assets/thiings/secure-shield.png';
import groupFriends from '../assets/thiings/group-friends.png';
import redstoneLightning from '../assets/thiings/redstone-lightning.png';
import compatPuzzle from '../assets/thiings/compat-puzzle.png';
import licenseWarranty from '../assets/thiings/license-warranty.png';

const art = {
  setup: setupGear,
  secure: secureShield,
  group: groupFriends,
  redstone: redstoneLightning,
  compat: compatPuzzle,
  license: licenseWarranty,
} as const;

interface Props {
  name: keyof typeof art;
  class?: string;
}

const { name, class: className = 'h-16 w-16' } = Astro.props;
---

<Image src={art[name]} alt="" width={96} height={96} class={className} />
