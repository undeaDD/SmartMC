---
import arrowRight from 'iconoir/icons/regular/arrow-right.svg?raw';
import checkCircle from 'iconoir/icons/regular/check-circle.svg?raw';
import clock from 'iconoir/icons/regular/clock.svg?raw';
import download from 'iconoir/icons/regular/download.svg?raw';
import githubIcon from 'iconoir/icons/regular/github.svg?raw';
import homeSimple from 'iconoir/icons/regular/home-simple.svg?raw';
import openBook from 'iconoir/icons/regular/open-book.svg?raw';
// Inlines a raw Iconoir SVG (MIT licensed, https://iconoir.com) by name.
// Using the plain `iconoir` package's SVG files directly rather than
// `iconoir-react`, since this is a plain Astro site with no React runtime.
import shield from 'iconoir/icons/regular/shield.svg?raw';
import xmarkCircle from 'iconoir/icons/regular/xmark-circle.svg?raw';

const icons = {
  shield,
  github: githubIcon,
  'arrow-right': arrowRight,
  book: openBook,
  download,
  'check-circle': checkCircle,
  clock,
  'xmark-circle': xmarkCircle,
  home: homeSimple,
} as const;

interface Props {
  name: keyof typeof icons;
  class?: string;
}

const { name, class: className = 'w-6 h-6' } = Astro.props;
const svg = icons[name].replace('<svg ', `<svg class="${className}" `);
---

<Fragment set:html={svg} />
