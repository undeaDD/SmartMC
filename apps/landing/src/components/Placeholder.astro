---
interface Props {
  label: string;
  class?: string;
  aspect?: string;
}

const { label, class: className = '', aspect = 'aspect-video' } = Astro.props;
---

<div
  class={`relative ${aspect} overflow-hidden rounded-2xl border border-dashed border-ink-600 bg-ink-900/60 ${className}`}
>
  <div class="bg-grid absolute inset-0 opacity-70"></div>
  <div class="relative flex h-full flex-col items-center justify-center gap-2 p-6 text-center">
    <svg class="h-8 w-8 text-ink-600" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5" />
      <circle cx="8.5" cy="8.5" r="1.5" stroke="currentColor" stroke-width="1.5" />
      <path d="M21 15l-5-5-9 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    <p class="text-xs font-medium text-brand-gray">{label}</p>
  </div>
</div>
