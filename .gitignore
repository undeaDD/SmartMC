# --- Stonecutter-generated per-version-loader subprojects (apps/mod) ---
# Entirely generated build output (bin/build/.gradle/.eclipse/run), no hand-authored
# content ever lives here -- also where absolute local paths (incl. Windows
# username) can leak into IDE launch configs if not excluded.
apps/mod/versions/

# --- Claude Code session-local state (launch.json itself is tracked) ---
.claude/scheduled_tasks.lock
.claude/*.lock

# --- Secrets ---
.env
.env.*
!.env.example
config/smartmc/server_identity.ed25519
