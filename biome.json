{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "apps/mobile/**/*.{ts,tsx,js,jsx,mjs,cjs,json}",
      "apps/landing/**/*.{ts,tsx,js,jsx,mjs,cjs,json}",
      "packages/**/*.{ts,tsx,js,jsx,mjs,cjs,json}",
      "*.json",
      "!**/dist",
      "!**/build",
      "!**/.astro",
      "!apps/mod"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "json": {
    "formatter": {
      "enabled": true
    }
  }
}
